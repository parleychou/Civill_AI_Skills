{"title":"Element (official JSON Manual)","input_uri":"/db/ELEM","methods":["POST","GET","PUT","DELETE"],"evidence":"shared","product_hint":"NX series official JSON Manual","official_url":"https://support.midasuser.com/hc/en-us/articles/35806934300825-Element","edited":"2025-11-04","notes":"Official page also contains 'MIDAS CIVIL NX only' and/or 'MIDAS GEN NX only' markers. The converted public page did not bind those footnotes to specific rows, so this catalog does not invent which fields are product-exclusive. Confirm on the live official page.","fields":[{"key":"TYPE","name":"Element Type","type":"String","required":"Optional","default":"\"BEAM\"","group":"Common Keys and Solid","enums":["BEAM","TRUSS","TENSTR","COMPTR","PLATE","WALL","PLSTRS","PLSTRN","AXISYM","SOLID"]},{"key":"MATL","name":"Material No.","type":"Integer","required":"Required","group":"Common Keys and Solid"},{"key":"SECT","name":"Section / Thickness No.","type":"Integer","required":"Required","group":"Common Keys and Solid"},{"key":"NODE","name":"Node No.","type":"Array [Integer]","required":"Required","group":"Common Keys and Solid","notes":"Max 8 integers; unused trailing nodes may be 0."},{"key":"ANGLE","name":"Beta Angle","type":"Number","required":"Optional","default":"0","group":"Beam, Truss, Plate, Wall, etc."},{"key":"STYPE","name":"Element Subtype","type":"Integer","required":"Required when used","group":"depends on TYPE","notes":"Plate: Thick 1, Thin 2, Thick with Drilling DOF 3, Thin with Drilling DOF 4. Wall: Membrane 1, Plate 2. Cable: CABLE 1 Pretension, 2 Horizontal, 3 Lu."},{"key":"TENS","name":"Tension/allowable force","type":"Number","required":"Optional","default":"0"},{"key":"T_LIMIT","name":"Tension/compression limit value","type":"Number","required":"Optional"},{"key":"T_bLMT","name":"Use tension/compression limit","type":"Boolean","required":"Optional","default":"false"},{"key":"NON_LEN","name":"Hook length / Gap / Lu","type":"Number","required":"depends on subtype"},{"k