{"title":"Unit System (official JSON Manual)","input_uri":"/db/UNIT","methods":["GET","PUT"],"evidence":"shared","product_hint":"NX series official JSON Manual (CIVIL NX and GEN NX listed in the manual introduction)","official_url":"https://support.midasuser.com/hc/en-us/articles/35802155483801-Unit-System","edited":"2024-08-01","notes":"Official specification lists FORCE/DIST/HEAT/TEMPER as Optional. The Civil NX local handbook (2025-12-23) lists the same keys as Required. Use the current product page; do not assume either requiredness without checking.","fields":[{"key":"FORCE","name":"Force (Mass)","type":"String","required":"Optional (official page)","enums":["N","KN","KGF","TONF","LBF","KIPS"]},{"key":"DIST","name":"Length","type":"String","required":"Optional (official page)","enums":["M","CM","MM","FT","IN"]},{"key":"HEAT","name":"Heat","type":"String","required":"Optional (official page)","enums":["CAL","KCAL","J","KJ","BTU"]},{"key":"TEMPER","name":"Temperature Unit","type":"String","required":"Optional (official page)","enums":["C","F"],"notes":"Do not confuse with TEMP used under post/TABLE UNIT."}],"examples":[{"label":"Official example","body":{"Assign":{"1":{"FORCE":"KIPS","DIST":"FT","HEAT":"BTU","TEMPER":"C"}}}}],"schema_props":[{"key":"FORCE","type":"string","description":"Force"},{"key":"DIST","type":"string","description":"Distance"},{"key":"HEAT","type":"string","description":"Heat"},{"key":"TEMPER","type":"string","description":"TemperUnit"}],"keywords":["UNIT","单位","单位系统"]}
