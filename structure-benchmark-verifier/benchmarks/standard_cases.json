        { "quantity": "reaction", "node": 2, "component": "ry", "expected": 5000, "relTol": 1e-9 },
        { "quantity": "endForce", "element": 1, "component": "axial", "expected": 3333.3333333333335, "relTol": 1e-9, "formula": "下弦受拉 P/2/tanθ" },
        { "quantity": "endForce", "element": 2, "component": "axial", "expected": -6009.252125773315, "relTol": 1e-9, "formula": "斜杆受压 -P/(2sinθ)" },
        { "quantity": "endForce", "element": 3, "component": "axial", "expected": -6009.252125773315, "relTol": 1e-9 },
        { "quantity": "endForce", "element": 2, "component": "Mi", "expected": 0, "absTol": 1e-6, "formula": "二力杆无弯矩" },
