{
  "schemaVersion": "2.0",
  "units": {
    "length": "m",
    "force": "N",
    "moment": "N*m",
    "modulus": "Pa",
    "note": "全部为 SI 基本单位。kN / kN*m 仅在展示层换算，不得混入计算。"
  },
  "conventions": {
    "globalAxes": "X 向右为正，Y 向上为正，转角逆时针为正",
    "elementLoadQ": "q 为局部 -y 方向均布荷载集度，q > 0 压向杆件下侧",
    "moment": "M(x) 下侧受拉为正 (sagging positive)",
    "axial": "受拉为正",
    "reaction": "支座反力，方向与整体坐标正向一致"
  },
  "cases": [
    {
      "id": "CASE-01",
      "name": "简支梁满跨均布荷载",
      "description": "L=6m, q=10kN/m, E=200GPa, I=1e-4 m^4。跨中设节点以便校核跨中挠度。",
      "model": {
        "nodes": [
          { "id": 1, "x": 0, "y": 0, "fixity": [true, true, false] },
          { "id": 2, "x": 3, "y": 0, "fixity": [false, false, false] },
          { "id": 3, "x": 6, "y": 0, "fixity": [false, true, false] }
        ],
        "elements": [
          { "id": 1, "nodeI": 1, "nodeJ": 2, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000 },
          { "id": 2, "nodeI": 2, "nodeJ": 3, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000 }
        ],
        "loads": []
      },
      "checks": [
        { "quantity": "displacement", "node": 2, "component": "dy", "expected": -0.0084375, "relTol": 1e-6, "formula": "-5qL^4/(384EI)" },
        { "quantity": "reaction", "node": 1, "component": "ry", "expected": 30000, "relTol": 1e-9, "formula": "qL/2" },
        { "quantity": "reaction", "node": 3, "component": "ry", "expected": 30000, "relTol": 1e-9, "formula": "qL/2" },
        { "quantity": "reaction", "node": 1, "component": "rx", "expected": 0, "absTol": 1e-6 },
        { "quantity": "moment", "element": 1, "x": 3.0, "expected": 45000, "relTol": 1e-9, "formula": "qL^2/8 (跨中，下侧受拉)" },
        { "quantity": "shear", "element": 1, "x": 0.0, "expected": 30000, "relTol": 1e-9 },
        { "quantity": "moment", "element": 1, "x": 0.0, "expected": 0, "absTol": 1e-6, "formula": "简支端弯矩为 0" }
      ]
    },
    {
      "id": "CASE-02",
      "name": "悬臂梁自由端集中荷载",
      "description": "L=4m, 自由端竖向集中力 P=20kN 向下。",
      "model": {
        "nodes": [
          { "id": 1, "x": 0, "y": 0, "fixity": [true, true, true] },
          { "id": 2, "x": 4, "y": 0, "fixity": [false, false, false] }
        ],
        "elements": [
          { "id": 1, "nodeI": 1, "nodeJ": 2, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 0 }
        ],
        "loads": [{ "nodeId": 2, "fx": 0, "fy": -20000, "mz": 0 }]
      },
      "checks": [
        { "quantity": "displacement", "node": 2, "component": "dy", "expected": -0.021333333333333333, "relTol": 1e-9, "formula": "-PL^3/(3EI)" },
        { "quantity": "displacement", "node": 2, "component": "rz", "expected": -0.008, "relTol": 1e-9, "formula": "-PL^2/(2EI)" },
        { "quantity": "reaction", "node": 1, "component": "ry", "expected": 20000, "relTol": 1e-9 },
        { "quantity": "reaction", "node": 1, "component": "rm", "expected": 80000, "relTol": 1e-9, "formula": "P*L，逆时针为正" },
        { "quantity": "moment", "element": 1, "x": 0.0, "expected": -80000, "relTol": 1e-9, "formula": "-P*L，负号代表上侧受拉" },
        { "quantity": "moment", "element": 1, "x": 4.0, "expected": 0, "absTol": 1e-6 }
      ]
    },
    {
      "id": "CASE-03",
      "name": "两跨等跨连续梁满跨均布荷载",
      "description": "L1=L2=6m, q=10kN/m。在 x=3L/8=2.25m 与 9.75m 处设节点，正好落在跨内弯矩极值截面。",
      "model": {
        "nodes": [
