        "elements": [
          { "id": 1, "nodeI": 1, "nodeJ": 2, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000 },
          { "id": 2, "nodeI": 2, "nodeJ": 3, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000 },
          { "id": 3, "nodeI": 3, "nodeJ": 4, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000 },
          { "id": 4, "nodeI": 4, "nodeJ": 5, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000 }
        ],
        "loads": []
      },
      "checks": [
        { "quantity": "reaction", "node": 1, "component": "ry", "expected": 22500, "relTol": 1e-9, "formula": "3qL/8" },
        { "quantity": "reaction", "node": 3, "component": "ry", "expected": 75000, "relTol": 1e-9, "formula": "5qL/4" },
        { "quantity": "reaction", "node": 5, "component": "ry", "expected": 22500, "relTol": 1e-9, "formula": "3qL/8" },
        { "quantity": "moment", "element": 2, "x": 3.75, "expected": -45000, "relTol": 1e-9, "formula": "-qL^2/8 中支座，上侧受拉" },
        { "quantity": "moment", "element": 1, "x": 2.25, "expected": 25312.5, "relTol": 1e-9, "formula": "9qL^2/128 跨内最大正弯矩" },
        { "quantity": "maxMoment", "element": 1, "expected": 25312.5, "expectedX": 2.25, "relTol": 1e-9 }
      ]
    },
    {
      "id": "CASE-04",
      "name": "单跨门式刚架（固定支座）梁上满跨均布荷载",
      "description": "柱高 4m，梁跨 6m，全部构件 E=200GPa、I=1e-4 m^4、A=0.01 m^2，梁上 q=10kN/m。对称结构对称荷载，无侧移。",
      "toleranceNote": "解析解由位移法（转角位移方程）导出，前提是【忽略轴向变形】。求解器计入梁的轴向压缩后结果相差约 0.5%，因此本例容差放宽到 1%。若把 A 增大到 1.0 m^2 再跑，误差会收敛到 0.01% 以内——这可以用来确认偏差确实来自轴向变形而非算法错误。",
      "model": {
        "nodes": [
          { "id": 1, "x": 0, "y": 0, "fixity": [true, true, true] },
          { "id": 2, "x": 0, "y": 4, "fixity": [false, false, false] },
          { "id": 3, "x": 6, "y": 4, "fixity": [false, false, false] },
          { "id": 4, "x": 6, "y": 0, "fixity": [true, true, true] }
        ],
        "elements": [
          { "id": 1, "nodeI": 1, "nodeJ": 2, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 0 },
          { "id": 2, "nodeI": 2, "nodeJ": 3, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000 },
          { "id": 3, "nodeI": 4, "nodeJ": 3, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 0 }
        ],
        "loads": []
      },
      "checks": [
        { "quantity": "reaction", "node": 1, "component": "ry", "expected": 30000, "relTol": 1e-9, "formula": "qL/2，与轴向变形无关" },
        { "quantity": "reaction", "node": 1, "component": "rx", "expected": 8437.5, "relTol": 0.01, "formula": "(M_AB+M_BA)/h" },
        { "quantity": "reaction", "node": 1, "component": "rm", "expected": -11250, "relTol": 0.01, "formula": "柱底弯矩 2EIθ/h" },
        { "quantity": "moment", "element": 2, "x": 0.0, "expected": -22500, "relTol": 0.01, "formula": "梁端弯矩，上侧受拉" },
        { "quantity": "moment", "element": 2, "x": 3.0, "expected": 22500, "relTol": 0.01, "formula": "qL^2/8 - 22500 跨中，下侧受拉" }
      ]
    },
    {
      "id": "CASE-05",
      "name": "一端固定一端铰支梁（杆端弯矩释放）满跨均布荷载",
      "description": "L=6m, q=10kN/m。用单元 j 端弯矩释放模拟铰支端，专门校核静力凝聚是否正确。",
      "model": {
        "nodes": [
          { "id": 1, "x": 0, "y": 0, "fixity": [true, true, true] },
          { "id": 2, "x": 6, "y": 0, "fixity": [false, true, false] }
        ],
        "elements": [
          { "id": 1, "nodeI": 1, "nodeJ": 2, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 10000, "releaseJ": true }
        ],
        "loads": []
      },
      "checks": [
        { "quantity": "reaction", "node": 1, "component": "ry", "expected": 37500, "relTol": 1e-9, "formula": "5qL/8" },
        { "quantity": "reaction", "node": 1, "component": "rm", "expected": 45000, "relTol": 1e-9, "formula": "qL^2/8" },
        { "quantity": "reaction", "node": 2, "component": "ry", "expected": 22500, "relTol": 1e-9, "formula": "3qL/8" },
        { "quantity": "moment", "element": 1, "x": 0.0, "expected": -45000, "relTol": 1e-9, "formula": "-qL^2/8 固定端，上侧受拉" },
        { "quantity": "endForce", "element": 1, "component": "Mj", "expected": 0, "absTol": 1e-6, "formula": "释放端弯矩必须严格为 0" },
        { "quantity": "maxSaggingMoment", "element": 1, "expected": 25312.5, "expectedX": 3.75, "relTol": 1e-9, "formula": "9qL^2/128 @ 5L/8 跨内最大正弯矩" },
        { "quantity": "maxHoggingMoment", "element": 1, "expected": -45000, "expectedX": 0, "relTol": 1e-9, "formula": "固定端最大负弯矩" }
      ]
    },
    {
      "id": "CASE-06",
      "name": "三杆平面桁架（全铰接）",
      "description": "下弦跨度 4m，顶点位于 (2, 3)，顶点作用 10kN 向下集中力。所有杆件两端弯矩释放，构成理想桁架。",
      "model": {
        "nodes": [
          { "id": 1, "x": 0, "y": 0, "fixity": [true, true, false] },
