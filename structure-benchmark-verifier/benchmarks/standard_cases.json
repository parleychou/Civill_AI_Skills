          { "id": 2, "nodeI": 1, "nodeJ": 3, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 0, "releaseI": true, "releaseJ": true },
          { "id": 3, "nodeI": 2, "nodeJ": 3, "E": 2.0e11, "A": 0.01, "I": 1.0e-4, "q": 0, "releaseI": true, "releaseJ": true }
        ],
        "loads": [{ "nodeId": 3, "fx": 0, "fy": -10000, "mz": 0 }]
      },
      "checks": [
